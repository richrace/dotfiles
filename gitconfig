[credential]
  helper = cache
[user]
  name = Richard Race
  email = 1273965+richrace@users.noreply.github.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHunSbM97f33eDQ+vbtoXW1Rv/0iNEbJZqH+TZdCPvkh
[difftool]
  prompt = false
[core]
  pager = diff-so-fancy | less --tabs=2 -cr
  excludesfile = /Users/rich/.gitignore_global
  editor = ws --wait
[color]
  ui = always
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[color "diff"]
  meta = yellow bold
  commit = green bold
  frag = magenta bold
  old = red bold
  new = green bold
  whitespace = red reverse
[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = "red bold 52"
  newNormal = "green bold"
  newHighlight = "green bold 22"
[commit]
  gpgsign = true
  template = /Users/rich/.gitmessage
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[init]
  defaultBranch = main
[gpg]
  format = ssh
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[push]
  autoSetupRemote = true
